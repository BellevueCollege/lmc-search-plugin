{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "lmc-search-plugin/lmc-search-block",
    "title": "LMC Catalog Search Box",
    "category": "layout",
    "icon": "search",
    "description": "Block to search the LMC catalog",
    "version": "1.0.0",
    "textdomain": "lmc-search-plugin",
    "supports": {
        "html": false,
        "multiple": false
    },
    "attributes": {
        "headerText": {
            "type": "string",
            "default": "Search Bellevue College Library"
        },
        "helpText": {
            "type": "string",
            "default": "Search for articles, books, and more"
        }
    },
    "editorScript": "file:./index.js",
    "viewScript": [ "file:./view.js" ],
    "style": [ "file:./style-index.css"],
    "editorStyle": "file:./index.css",
    "render": "file:./render.php"
}
